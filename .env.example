APP_NAME=DriveFleet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drivefleet
DB_USERNAME=drivefleet
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Emails and texts are queued; `php artisan dev` runs a worker (production needs `php artisan queue:work`).
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails go to storage/logs until a real mailer is set (e.g. smtp, postmark, resend).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@drivefleet.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VITE_GOOGLE_MAPS_API_KEY=

PLATFORM_COMMISSION_RATE=0.10

# Text messages: "log" writes them to storage/logs; "africastalking" sends them.
# Use AFRICASTALKING_USERNAME=sandbox with a sandbox API key for testing.
SMS_DRIVER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# M-PESA STK push. "simulate" pretends locally (no money moves); "daraja" uses
# Safaricom's API. Get sandbox keys at developer.safaricom.co.ke. The callback
# token is a long random string; results are posted to
# APP_URL/webhooks/mpesa/{MPESA_CALLBACK_TOKEN}, which must be reachable over HTTPS.
MPESA_DRIVER=simulate
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_TOKEN=
MPESA_CALLBACK_URL=

# Card payments. "simulate" shows a test checkout page; "paystack" uses Paystack's
# hosted checkout. Point the Paystack webhook at APP_URL/webhooks/paystack.
CARD_DRIVER=simulate
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=KES
